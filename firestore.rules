rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{document=**} { allow read, write: if true; }
    match /categories/{document=**} { allow read, write: if true; }
    match /products/{document=**} { allow read, write: if true; }
    match /shifts/{document=**} { allow read, write: if true; }
    match /sales/{document=**} { allow read, write: if true; }
  }
}
